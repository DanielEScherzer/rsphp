
/// Module for `HasMagic` interface.
pub(crate) mod HasMagic {
    use rsphp_sys::{zend_class_entry, zend_class_implements};


    /// Register the `HasMagic` interface.
    pub(crate) fn register_interface(zend_ce_Countable: *mut zend_class_entry, zend_ce_Stringable: *mut zend_class_entry) -> *mut zend_class_entry {
        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        rsphp_macros_c::INIT_CLASS_ENTRY!(ce, "HasMagic", NULL);
        let class_entry: *mut zend_class_entry = unsafe {
            rsphp_sys::zend_register_internal_interface(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
            )
        };
        unsafe {
            zend_class_implements(
                class_entry,
                2,
                zend_ce_Countable,
                zend_ce_Stringable,
            )
        };


        class_entry
    }
}
