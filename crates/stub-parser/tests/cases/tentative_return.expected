
/// Module for `Demo` class.
pub(crate) mod Demo {
    use rsphp_macros_c::INIT_CLASS_ENTRY;
    use rsphp_macros_rs::{ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_OBJ_INFO, ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_TYPE_MASK};
    use rsphp_sys::{MAY_BE_ARRAY, MAY_BE_LONG, MAY_BE_STRING, zend_class_entry, zend_function_entry, zend_internal_arg_info, zend_register_internal_class_with_flags};

    /// Argument information for `Demo::test1()`.
    pub(crate) const ARGINFO_TEST1: [zend_internal_arg_info; 1] = [
        ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_TYPE_MASK!(0, 0, MAY_BE_ARRAY, 1),
    ];

    /// Argument information for `Demo::test2()`.
    pub(crate) const ARGINFO_TEST2: [zend_internal_arg_info; 1] = [
        ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_OBJ_INFO!(0, 0, "SomeObject", 1, 1),
    ];

    /// Argument information for `Demo::test3()`.
    pub(crate) const ARGINFO_TEST3: [zend_internal_arg_info; 1] = [
        ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_TYPE_MASK!(0, 0, MAY_BE_LONG|MAY_BE_STRING, 1),
    ];

    /// Register the `Demo` class.
    pub(crate) fn register_class(methods: &[zend_function_entry]) -> *mut zend_class_entry {
        assert_eq!(4, methods.len(), "Demo should have 3 methods");

        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        INIT_CLASS_ENTRY!(ce, "Demo", methods);
        let class_entry: *mut zend_class_entry = unsafe {
            zend_register_internal_class_with_flags(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
                std::ptr::null_mut(),
                0,
            )
        };


        class_entry
    }
}
