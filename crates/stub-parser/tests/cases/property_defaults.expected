        let mut property_str_other_default_value: zval = unsafe { std::mem::zeroed() };
        let property_str_other_default_str = unsafe { zend_string_init(c"foo".as_ptr(), "foo".len(), true) };

        unsafe { ZVAL_INTERNED_STR!(std::ptr::from_mut::<zval>(&mut property_str_other_default_value), property_str_other_default_str); }
        let property_str_other_name: *mut zend_string = unsafe {
            zend_string_init(
