
/// Module for `Repository` class.
pub(crate) mod Repository {
    use rsphp_macros_c::{INIT_CLASS_ENTRY, ZEND_ARG_OBJ_INFO, ZEND_ARG_OBJ_INFO_WITH_DEFAULT_VALUE, ZEND_ARG_TYPE_INFO};
    use rsphp_macros_rs::ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_OBJ_INFO;
    use rsphp_sys::{IS_ARRAY, IS_STRING, ZEND_ACC_FINAL, ZEND_ACC_NOT_SERIALIZABLE, ZEND_ACC_NO_DYNAMIC_PROPERTIES, zend_class_entry, zend_function_entry, zend_internal_arg_info, zend_register_internal_class_with_flags};

    /// Argument information for `Repository::commit()`.
    pub(crate) const ARGINFO_COMMIT: [zend_internal_arg_info; 6] = [
        ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_OBJ_INFO!(0, 4, "Oid", 0, 0),
        ZEND_ARG_OBJ_INFO!(0, "treeId", "Oid", 0),
        ZEND_ARG_TYPE_INFO!(0, "message", IS_STRING, 0),
        ZEND_ARG_TYPE_INFO!(0, "parents", IS_ARRAY, 0),
        ZEND_ARG_OBJ_INFO!(0, "author", "Signature", 0),
        ZEND_ARG_OBJ_INFO_WITH_DEFAULT_VALUE!(0, "committer", "Signature", 1, "null"),
    ];

    /// Register the `Repository` class.
    pub(crate) fn register_class(methods: &[zend_function_entry]) -> *mut zend_class_entry {
        assert_eq!(2, methods.len(), "Repository should have 1 methods");

        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        INIT_CLASS_ENTRY!(ce, "Repository", methods);
        let class_entry: *mut zend_class_entry = unsafe {
            zend_register_internal_class_with_flags(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
                std::ptr::null_mut(),
                ZEND_ACC_FINAL|ZEND_ACC_NO_DYNAMIC_PROPERTIES|ZEND_ACC_NOT_SERIALIZABLE,
            )
        };


        class_entry
    }
}
