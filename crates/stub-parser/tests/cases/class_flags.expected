/// Module for `AllowsDynamicProperties` class.
pub(crate) mod AllowsDynamicProperties {
    use rsphp_sys::{ZEND_ACC_ALLOW_DYNAMIC_PROPERTIES, zend_add_class_attribute, zend_class_entry, zend_string, zend_string_init_interned, zend_string_release_ex};


    /// Register the `AllowsDynamicProperties` class.
    pub(crate) fn register_class() -> *mut zend_class_entry {
        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        rsphp_macros_c::INIT_CLASS_ENTRY!(ce, "AllowsDynamicProperties", NULL);
        let class_entry: *mut zend_class_entry = unsafe {
            rsphp_sys::zend_register_internal_class_with_flags(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
                std::ptr::null_mut(),
                ZEND_ACC_ALLOW_DYNAMIC_PROPERTIES,
            )
        };


        unsafe {
            let name: *mut zend_string = (zend_string_init_interned.expect("zend_string_init_interned should be set"))(
                c"AllowDynamicProperties".as_ptr(),
                "AllowDynamicProperties".len(),
                true,
            );
            zend_add_class_attribute(class_entry, name, 0);
            zend_string_release_ex(name, true);
        }
        class_entry
    }
}
