/// Module for `Demo` class.
pub(crate) mod Demo {
    use rsphp_macros_c::{ZSTR_KNOWN, ZSTR_LEN, ZVAL_STR};
    use rsphp_macros_rs::ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_TYPE_MASK;
    use rsphp_sys::{HashTable, MAY_BE_VOID, _zend_known_string_id, zend_add_function_attribute, zend_attribute, zend_class_entry, zend_function, zend_function_entry, zend_hash_str_find_ptr, zend_internal_arg_info, zend_string_init, zval};

    /// Argument information for `Demo::test1()`.
    pub(crate) const ARGINFO_TEST1: [zend_internal_arg_info; 1] = [
        ZEND_ARG_INFO_FOR_FUNCTION_WITH_RETURN_TYPE_MASK!(0, 0, MAY_BE_VOID, 0),
    ];

    /// Register the `Demo` class.
    pub(crate) fn register_class(methods: &[zend_function_entry]) -> *mut zend_class_entry {
        assert_eq!(2, methods.len(), "Demo should have 1 methods");

        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        rsphp_macros_c::INIT_CLASS_ENTRY!(ce, "Demo", methods);
        let class_entry: *mut zend_class_entry = unsafe {
            rsphp_sys::zend_register_internal_class_with_flags(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
                std::ptr::null_mut(),
                0,
            )
        };


        unsafe {
            let fn_ptr: *mut zend_function = zend_hash_str_find_ptr(
                std::ptr::from_ref::<HashTable>(&(*class_entry).function_table),
                c"test1".as_ptr(),
                "test1".len(),
            ).cast::<zend_function>();
            assert_eq!(10, ZSTR_LEN!(ZSTR_KNOWN!(_zend_known_string_id::ZEND_STR_DEPRECATED_CAPITALIZED)));
            let attrib: *mut zend_attribute = zend_add_function_attribute(fn_ptr, ZSTR_KNOWN!(_zend_known_string_id::ZEND_STR_DEPRECATED_CAPITALIZED), 2);
            (*(*attrib).args.as_mut_ptr().add(0)).name = ZSTR_KNOWN!(_zend_known_string_id::ZEND_STR_SINCE);
            let arg_0_value = zend_string_init(c"123".as_ptr(), "123".len(), true);
            ZVAL_STR!(std::ptr::from_mut::<zval>(&mut (*(*attrib).args.as_mut_ptr().add(0)).value), arg_0_value);
            (*(*attrib).args.as_mut_ptr().add(1)).name = ZSTR_KNOWN!(_zend_known_string_id::ZEND_STR_MESSAGE);
            let arg_1_value = zend_string_init(c"456".as_ptr(), "456".len(), true);
            ZVAL_STR!(std::ptr::from_mut::<zval>(&mut (*(*attrib).args.as_mut_ptr().add(1)).value), arg_1_value);
        }
        class_entry
    }
}
