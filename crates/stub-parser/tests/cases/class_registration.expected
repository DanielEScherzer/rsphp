
/// Module for `Demo` class.
pub(crate) mod Demo {
    use rsphp_macros_c::{ZEND_TYPE_INIT_MASK, ZVAL_UNDEF};
    use rsphp_sys::{MAY_BE_LONG, ZEND_ACC_PRIVATE, zend_class_entry, zend_declare_typed_property, zend_string, zend_string_init, zend_string_release, zval};


    /// Register the `Demo` class.
    pub(crate) fn register_class() -> *mut zend_class_entry {
        let mut ce: zend_class_entry = unsafe { std::mem::zeroed() };
        rsphp_macros_c::INIT_CLASS_ENTRY!(ce, "Demo", NULL);
        let class_entry: *mut zend_class_entry = unsafe {
            rsphp_sys::zend_register_internal_class_with_flags(
                std::ptr::from_mut::<zend_class_entry>(&mut ce),
                std::ptr::null_mut(),
                0,
            )
        };

        let mut property_inner_default_value: zval = unsafe { std::mem::zeroed() };
        unsafe { ZVAL_UNDEF!(std::ptr::from_mut::<zval>(&mut property_inner_default_value)); }
        let property_inner_name: *mut zend_string = unsafe {
            zend_string_init(
                c"inner".as_ptr(),
                "inner".len(),
                true,
            )
        };
        unsafe {
            zend_declare_typed_property(
                class_entry,
                property_inner_name,
                std::ptr::from_mut::<zval>(&mut property_inner_default_value),
                ZEND_ACC_PRIVATE as i32,
                std::ptr::null_mut(),
                ZEND_TYPE_INIT_MASK!(MAY_BE_LONG),
            );
        }
        unsafe {
            zend_string_release(property_inner_name);
        }

        class_entry
    }
}
